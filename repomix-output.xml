import { Plus, Minus, Crosshair, Layers, LocateFixed } from 'lucide-react';
import { useMap } from 'react-leaflet';
import { useAppData } from '../../context/AppDataContext';
import useGeolocation from '../../hooks/useGeolocation';

export default function MapControls() {
  const map = useMap();
  const { mapLayer, setMapLayer, applyGpsLocation, activeLocation } = useAppData();
  const { requestLocation, loading } = useGeolocation();

  const layers = [
    { id: 'standard', label: 'Standard' },
    { id: 'satellite', label: 'Satellite' },
    { id: 'terrain', label: 'Terrain' },
  ];

  return (
    <div className="absolute right-3 top-3 z-[1000] flex flex-col gap-2">
      <div className="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-md">
        <button
          type="button"
          aria-label="Zoom in"
          className="flex h-10 w-10 items-center justify-center border-b border-slate-100 text-slate-700 hover:bg-slate-50"
          onClick={() => map.zoomIn()}
        >
          <Plus className="h-4 w-4" />
        </button>
        <button
          type="button"
          aria-label="Zoom out"
          className="flex h-10 w-10 items-center justify-center text-slate-700 hover:bg-slate-50"
          onClick={() => map.zoomOut()}
        >
          <Minus className="h-4 w-4" />
        </button>
      </div>

      <button
        type="button"
        aria-label="Use my location"
        disabled={loading}
        className="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-brand-700 shadow-md hover:bg-brand-50 disabled:opacity-50"
        onClick={async () => {
          try {
            const pos = await requestLocation();
            await applyGpsLocation(pos);
            map.flyTo([pos.lat, pos.lon], Math.max(map.getZoom(), 13), { duration: 0.8 });
          } catch {
            /* error surfaced in hook */
          }
        }}
      >
        {activeLocation?.source === 'gps' ? (
          <LocateFixed className="h-4 w-4" />
        ) : (
          <Crosshair className="h-4 w-4" />
        )}
      </button>

      <div className="group relative">
        <button
          type="button"
          aria-label="Map layers"
          className="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-brand-700 text-white shadow-md hover:bg-brand-800"
        >
          <Layers className="h-4 w-4" />
        </button>
        <div className="pointer-events-none absolute right-12 top-0 hidden w-36 rounded-xl border border-slate-200 bg-white p-1 shadow-lg group-hover:pointer-events-auto group-hover:block group-focus-within:pointer-events-auto group-focus-within:block">
          {layers.map((l) => (
            <button
              key={l.id}
              type="button"
              onClick={() => setMapLayer(l.id)}
              className={`flex w-full items-center rounded-lg px-3 py-2 text-left text-xs font-medium ${
                mapLayer === l.id
                  ? 'bg-brand-50 text-brand-800'
                  : 'text-slate-600 hover:bg-slate-50'
              }`}
            >
              {l.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}
