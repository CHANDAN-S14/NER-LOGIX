<file path="src/components/map/LiveMap.jsx">
import { useEffect, useMemo } from 'react';
import {
  MapContainer,
  TileLayer,
  Marker,
  Popup,
  Polyline,
  Polygon,
  CircleMarker,
  useMap,
} from 'react-leaflet';
import { useAppData } from '../../context/AppDataContext';
import { TILE_LAYERS } from './mapLayers';
import {
  originIcon,
  destinationIcon,
  vehicleIcon,
  incidentIcon,
  blockageIcon,
} from './markers';
import MapControls from './MapControls';
import MapLegend from './MapLegend';
import { normalizeRouteGeometry, coordsFromLocation } from '../../utils/geo';
import { riskPolylineColor, normalizeRiskLevel } from '../../utils/risk';
import Badge from '../common/Badge';

function FitBounds({ points }) {
  const map = useMap();
  useEffect(() => {
    if (!points?.length) return;
    if (points.length === 1) {
      map.flyTo(points[0], 13, { duration: 0.6 });
      return;
    }
    map.fitBounds(points, { padding: [48, 48], maxZoom: 14, animate: true });
  }, [map, points]);
  return null;
}

function LayerSwitcher({ layerId }) {
  const map = useMap();
  const layer = TILE_LAYERS[layerId] || TILE_LAYERS.standard;

  useEffect(() => {
    // Attribution / maxZoom handled by TileLayer key remount
    map.invalidateSize();
  }, [map, layerId]);

  return (
    <TileLayer
      key={layer.id}
      url={layer.url}
      attribution={layer.attribution}
      maxZoom={layer.maxZoom}
    />
  );
}

export default function LiveMap() {
  const {
    mapDefault,
    mapLayer,
    origin,
    destination,
    routes,
    selectedRoute,
    selectedRouteId,
    incidents,
    blockages,
    alerts,
    demoFleet,
    liveVehicles,
    activeLocation,
    risk,
  } = useAppData();

  const tile = TILE_LAYERS[mapLayer] || TILE_LAYERS.standard;

  const routePolylines = useMemo(() => {
    if (routes.status !== 'success' || !Array.isArray(routes.data)) return [];
    return routes.data.map((route, idx) => {
      const id = String(route.id || route._id || idx);
      const coords = normalizeRouteGeometry(route);
      const level = route.riskLevel || route.risk_level || route.level;
      const selected = String(selectedRouteId) === id;
      return {
        id,
        coords,
        color: riskPolylineColor(level),
        weight: selected ? 6 : 3,
        opacity: selected ? 0.95 : 0.45,
        dashArray: selected ? null : '8 10',
        selected,
        route,
      };
    });
  }, [routes, selectedRouteId]);

  const fitPoints = useMemo(() => {
    const pts = [];
    const o = coordsFromLocation(origin);
    const d = coordsFromLocation(destination);
    if (o) pts.push(o);
    if (d) pts.push(d);
    if (selectedRoute) {
      const geo = normalizeRouteGeometry(selectedRoute);
      if (geo.length) pts.push(...geo);
    }
    return pts;
  }, [origin, destination, selectedRoute]);

  const riskZones = useMemo(() => {
    const zones = [];
    // From AI risk response if polygons provided
    const analysis = risk.data;
    if (analysis?.zones && Array.isArray(analysis.zones)) {
      analysis.zones.forEach((z, i) => {
        if (z.coordinates?.length) {
          zones.push({
            id: `risk-${i}`,
            coords: z.coordinates,
            level: z.level || z.riskLevel,
            label: z.label || z.name,
          });
        }
      });
    }
    // From roads / blockages with polygon geometry
    if (blockages.status === 'success' && Array.isArray(blockages.data)) {
      blockages.data.forEach((b, i) => {
        if (b.polygon || b.geometry?.coordinates) {
          const coords = b.polygon || b.geometry.coordinates[0]?.map(([lon, lat]) => [lat, lon]);
          if (coords?.length) {
            zones.push({
              id: `block-${i}`,
              coords,
              level: 'blocked',
              label: b.name || 'Confirmed blockage',
              kind: 'blockage',
            });
          }
        }
      });
    }
    return zones;
  }, [risk.data, blockages]);

  const zoneColor = (level) => {
    const n = normalizeRiskLevel(level);
    if (n === 'blocked' || n === 'high') return { color: '#dc2626', fill: '#ef4444' };
    if (n === 'moderate') return { color: '#d97706', fill: '#f59e0b' };
    return { color: '#059669', fill: '#10b981' };
  };

  return (
    <div className="relative h-full w-full overflow-hidden rounded-none bg-slate-200 lg:rounded-l-none">
      <MapContainer
        center={mapDefault.center}
        zoom={mapDefault.zoom}
        zoomControl={false}
        className="h-full w-full"
        preferCanvas
      >
        <LayerSwitcher layerId={tile.id} />
        <MapControls />
        {fitPoints.length > 0 && <FitBounds points={fitPoints} />}

        {/* Risk / blockage polygons */}
        {riskZones.map((z) => {
          const c = zoneColor(z.level);
          return (
            <Polygon
              key={z.id}
              positions={z.coords}
              pathOptions={{
                color: c.color,
                fillColor: c.fill,
                fillOpacity: 0.22,
                weight: 2,
                dashArray: z.kind === 'blockage' ? null : '4 6',
              }}
            >
              {z.label && (
                <Popup>
                  <strong>{z.label}</strong>
                  {z.kind === 'blockage' && (
                    <div>
                      <Badge variant="danger" className="mt-1">
                        CONFIRMED BLOCKAGE
                      </Badge>
                    </div>
                  )}
                </Popup>
              )}
            </Polygon>
          );
        })}

        {/* Route polylines */}
        {routePolylines.map((r) =>
          r.coords.length > 1 ? (
            <Polyline
              key={r.id}
              positions={r.coords}
              pathOptions={{
                color: r.color,
                weight: r.weight,
                opacity: r.opacity,
                dashArray: r.dashArray,
                lineCap: 'round',
                lineJoin: 'round',
              }}
            />
          ) : null
        )}

        {/* Origin / Destination */}
        {origin?.lat != null && (
          <Marker position={[origin.lat, origin.lon]} icon={originIcon}>
            <Popup>
              <div className="text-xs">
                <strong>Origin</strong>
                <p className="mt-1 text-slate-600">{origin.label}</p>
              </div>
            </Popup>
          </Marker>
        )}
        {destination?.lat != null && (
          <Marker position={[destination.lat, destination.lon]} icon={destinationIcon}>
            <Popup>
              <div className="text-xs">
                <strong>Destination</strong>
                <p className="mt-1 text-slate-600">{destination.label}</p>
              </div>
            </Popup>
          </Marker>
        )}

        {/* Active location indicator */}
        {activeLocation?.lat != null && !origin && (
          <CircleMarker
            center={[activeLocation.lat, activeLocation.lon]}
            radius={8}
            pathOptions={{ color: '#0f766e', fillColor: '#14b8a6', fillOpacity: 0.7 }}
          />
        )}

        {/* Incidents */}
        {incidents.status === 'success' &&
          Array.isArray(incidents.data) &&
          incidents.data.map((inc) => {
            const lat = inc.lat ?? inc.latitude ?? inc.location?.lat;
            const lon = inc.lon ?? inc.lng ?? inc.longitude ?? inc.location?.lon;
            if (lat == null || lon == null) return null;
            const severity = (inc.severity || inc.level || 'MODERATE').toUpperCase();
            return (
              <Marker
                key={inc.id || inc._id || `${lat}-${lon}`}
                position={[lat, lon]}
                icon={incidentIcon(severity)}
              >
                <Popup>
                  <div className="max-w-[200px] text-xs">
                    <strong>{inc.type || 'Incident'}</strong>
                    <div className="mt-1">
                      <Badge
                        variant={
                          severity === 'BLOCKED' || severity === 'HIGH'
                            ? 'danger'
                            : severity === 'MODERATE'
                              ? 'warn'
                              : 'safe'
                        }
                      >
                        {severity}
                      </Badge>
                    </div>
                    {inc.description && (
                      <p className="mt-1 text-slate-600">{inc.description}</p>
                    )}
                  </div>
                </Popup>
              </Marker>
            );
          })}

        {/* Confirmed blockages (point markers) */}
        {blockages.status === 'success' &&
          Array.isArray(blockages.data) &&
          blockages.data.map((b) => {
            const lat = b.lat ?? b.latitude ?? b.location?.lat;
            const lon = b.lon ?? b.lng ?? b.longitude ?? b.location?.lon;
            if (lat == null || lon == null) return null;
            return (
              <Marker
                key={b.id || b._id || `blk-${lat}-${lon}`}
                position={[lat, lon]}
                icon={blockageIcon}
              >
                <Popup>
                  <div className="text-xs">
                    <Badge variant="danger">CONFIRMED BLOCKAGE</Badge>
                    <p className="mt-1 font-semibold">{b.name || b.roadName || 'Blocked road'}</p>
                    {b.description && <p className="mt-1 text-slate-600">{b.description}</p>}
                  </div>
                </Popup>
              </Marker>
            );
          })}

        {/* SACHET alerts — Potential Hazard (NOT auto-blockage) */}
        {alerts.status === 'success' &&
          Array.isArray(alerts.data) &&
          alerts.data.map((a) => {
            const lat = a.lat ?? a.latitude ?? a.location?.lat;
            const lon = a.lon ?? a.lng ?? a.longitude ?? a.location?.lon;
            if (lat == null || lon == null) return null;
            return (
              <CircleMarker
                key={a.id || a._id || `alert-${lat}-${lon}`}
                center={[lat, lon]}
                radius={10}
                pathOptions={{
                  color: '#b45309',
                  fillColor: '#f59e0b',
                  fillOpacity: 0.35,
                  weight: 2,
                  dashArray: '3 4',
                }}
              >
                <Popup>
                  <div className="text-xs">
                    <Badge variant="warn">POTENTIAL HAZARD</Badge>
                    <p className="mt-1 text-[10px] text-slate-500">SACHET / NDMA alert</p>
                    <p className="mt-1 font-semibold">{a.title || a.event || 'Disaster alert'}</p>
                    {a.description && <p className="mt-1 text-slate-600">{a.description}</p>}
                  </div>
                </Popup>
              </CircleMarker>
            );
          })}

        {/* Live vehicles from backend */}
        {liveVehicles.map((v) => {
          const lat = v.lat ?? v.latitude ?? v.position?.[0] ?? v.location?.lat;
          const lon = v.lon ?? v.lng ?? v.longitude ?? v.position?.[1] ?? v.location?.lon;
          if (lat == null || lon == null) return null;
          return (
            <Marker
              key={`live-${v.id || v._id || v.name}`}
              position={[lat, lon]}
              icon={vehicleIcon(false)}
            >
              <Popup>
                <div className="text-xs">
                  <Badge variant="live" dot>
                    LIVE
                  </Badge>
                  <p className="mt-1 font-semibold">{v.name || v.id}</p>
                  {v.status && <p className="text-slate-500">{v.status}</p>}
                </div>
              </Popup>
            </Marker>
          );
        })}

        {/* Demo fleet — explicitly labeled */}
        {demoFleet.map((v) => (
          <Marker
            key={`demo-${v.id}`}
            position={v.position}
            icon={vehicleIcon(true)}
          >
            <Popup>
              <div className="text-xs">
                <Badge variant="demo">DEMO FLEET</Badge>
                <p className="mt-1 text-[10px] font-medium uppercase tracking-wide text-amber-700">
                  Hackathon Simulation
                </p>
                <p className="mt-1 font-semibold">{v.name}</p>
                <p className="text-slate-500">{v.status}</p>
              </div>
            </Popup>
          </Marker>
        ))}
      </MapContainer>

      <MapLegend />
    </div>
  );
}
