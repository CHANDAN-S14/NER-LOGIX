import { BrowserRouter, Routes, Route } from 'react-router-dom';
import { AuthProvider } from './context/AuthContext';
import { AppDataProvider } from './context/AppDataContext';
import Dashboard from './pages/Dashboard';
import Login from './pages/Login';
import ProtectedRoute from './components/layout/ProtectedRoute';

/**
 * NER-LOGIX AI — frontend shell.
 *
 * Map dashboard is available for situational awareness.
 * Incident submission and other mutating actions require auth
 * (enforced in panels + ProtectedRoute for locked sections).
 *
 * To fully lock the dashboard behind login, wrap <Dashboard /> with ProtectedRoute.
 * Currently: dashboard is viewable; write actions require Sign in.
 */
export default function App() {
  return (
    <BrowserRouter>
      <AuthProvider>
        <AppDataProvider> 
          <Routes>
            <Route path="/" element={<Dashboard />} />
            <Route path="/login" element={<Login />} />
            <Route
              path="/report"
              element={
                <ProtectedRoute>
                  <Dashboard />
                </ProtectedRoute>
              }
            />
            <Route path="*" element={<Dashboard />} />
          </Routes>
        </AppDataProvider>
      </AuthProvider>
    </BrowserRouter>
  );
}
