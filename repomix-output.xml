<file path="src/components/incidents/RoadBlockagePanel.jsx">
import { useAppData } from '../../context/AppDataContext';
import Badge from '../common/Badge';
import StatusBanner from '../common/StatusBanner';
import Card, { CardHeader } from '../common/Card';

/**
 * Road blockages vs SACHET alerts are intentionally separate.
 * A SACHET disaster alert is NOT automatically a confirmed road blockage.
 */
export default function RoadBlockagePanel() {
  const { blockages, roads, alerts, isBackendLive } = useAppData();

  const confirmed =
    blockages.status === 'success' && Array.isArray(blockages.data)
      ? blockages.data
      : [];

  const restricted =
    roads.status === 'success' && Array.isArray(roads.data)
      ? roads.data.filter(
          (r) =>
            r.status === 'restricted' ||
            r.access === 'restricted' ||
            r.restriction
        )
      : [];

  const hazards =
    alerts.status === 'success' && Array.isArray(alerts.data) ? alerts.data : [];

  return (
    <section className="animate-fade-in space-y-4">
      <Card>
        <CardHeader
          title="Confirmed Blockages"
          action={<Badge variant="danger">CONFIRMED BLOCKAGE</Badge>}
        />
        {blockages.status === 'loading' && (
          <StatusBanner type="loading" title="Loading blockages…" />
        )}
        {blockages.status === 'error' && (
          <StatusBanner
            type={isBackendLive ? 'error' : 'offline'}
            title="Unable to load blockages"
            message={blockages.error}
          />
        )}
        {blockages.status === 'success' && confirmed.length === 0 && (
          <StatusBanner type="empty" title="No confirmed blocked roads" />
        )}
        {confirmed.length > 0 && (
          <ul className="space-y-2">
            {confirmed.map((b) => (
              <li
                key={b.id || b._id}
                className="rounded-xl border border-red-100 bg-danger-soft/40 px-3 py-2.5"
              >
                <p className="text-sm font-semibold text-slate-900">
                  {b.name || b.roadName || 'Blocked road'}
                </p>
                {b.description && (
                  <p className="mt-1 text-xs text-slate-600">{b.description}</p>
                )}
              </li>
            ))}
          </ul>
        )}
      </Card>

      <Card>
        <CardHeader
          title="Restricted Roads"
          action={<Badge variant="warn">Restricted</Badge>}
        />
        {roads.status === 'loading' && (
          <StatusBanner type="loading" title="Loading roads…" />
        )}
        {roads.status === 'error' && (
          <StatusBanner type="error" title="Unable to load roads" message={roads.error} />
        )}
        {roads.status === 'success' && restricted.length === 0 && (
          <StatusBanner type="empty" title="No restricted roads reported" />
        )}
        {restricted.length > 0 && (
          <ul className="space-y-2">
            {restricted.map((r) => (
              <li
                key={r.id || r._id}
                className="rounded-xl border border-amber-100 px-3 py-2.5"
              >
                <p className="text-sm font-semibold">{r.name || r.roadName}</p>
                {r.restriction && (
                  <p className="mt-1 text-xs text-slate-500">{r.restriction}</p>
                )}
              </li>
            ))}
          </ul>
        )}
      </Card>

      <Card>
        <CardHeader
          title="SACHET / NDMA Alerts"
          action={<Badge variant="warn">POTENTIAL HAZARD</Badge>}
        />
        <p className="mb-3 text-[11px] text-slate-500">
          Disaster alerts are potential hazards — not automatic road blockages.
        </p>
        {alerts.status === 'loading' && (
          <StatusBanner type="loading" title="Loading alerts…" />
        )}
        {alerts.status === 'error' && (
          <StatusBanner
            type="offline"
            title="SACHET unavailable"
            message={alerts.error}
          />
        )}
        {alerts.status === 'success' && hazards.length === 0 && (
          <StatusBanner type="empty" title="No active SACHET alerts" />
        )}
        {hazards.length > 0 && (
          <ul className="space-y-2">
            {hazards.map((a) => (
              <li
                key={a.id || a._id}
                className="rounded-xl border border-amber-200 bg-warn-soft/50 px-3 py-2.5"
              >
                <div className="flex items-start justify-between gap-2">
                  <p className="text-sm font-semibold text-slate-900">
                    {a.title || a.event || 'Alert'}
                  </p>
                  <Badge variant="warn">POTENTIAL HAZARD</Badge>
                </div>
                {a.description && (
                  <p className="mt-1 text-xs text-slate-600">{a.description}</p>
                )}
                {a.severity && (
                  <p className="mt-1 text-[10px] uppercase tracking-wide text-amber-700">
                    {a.severity}
                  </p>
                )}
              </li>
            ))}
          </ul>
        )}
      </Card>
    </section>
  );
}
